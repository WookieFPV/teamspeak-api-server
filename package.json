{
  "name": "bun-hono-server",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "run": "bun run src/index.ts",
    "format": "bunx biome format --write .",
    "lint": "bunx biome lint --fix",
    "lint:CI": "bunx biome check",
    "check": "bunx biome check --fix"
  },
  "dependencies": {
    "hono": "4.13.13",
    "p-queue": "9.3.5",
    "ts3-nodejs-library": "3.5.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
